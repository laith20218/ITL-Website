# متغيرات البيئة لموقع ITL
# انسخ هذا الملف إلى .env وعدّل القيم

# رابط قاعدة البيانات
# محليًا (SQLite):
DATABASE_URL="file:./db/custom.db"

# للإنتاج (Neon PostgreSQL — مجاني):
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# مفتاح تشفير جلسات المصادقة (JWT)
# ولّد مفتاحًا قويًا: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-32-char-secret"
