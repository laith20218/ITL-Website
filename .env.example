# ===== متغيرات البيئة لمشروع ITL =====

# قاعدة البيانات (محلي: SQLite، الإنتاج: PostgreSQL من Neon)
DATABASE_URL="file:./db/custom.db"

# مفتاح المصادقة (استبدله بمفتاح قوي)
AUTH_SECRET="itl-luxury-secret-key-change-in-prod"

# ===== Google OAuth (احصل عليها من Google Cloud Console) =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ===== البريد الإلكتروني (Gmail SMTP) =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ===== Upstash Redis للـ Rate Limiting (اختياري) =====
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ===== عنوان محفظة شام كاش =====
SHAMCASH_WALLET="815e5099c7147ea64668e1146619a101"
